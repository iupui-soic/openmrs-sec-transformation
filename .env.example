# Copy to .env and fill in. NEVER commit .env (gitignored).

# GitHub token with org read + security_events scope (needed for Dependabot and
# code-scanning alerts). Unauthenticated fallback works for public data at 60 req/hr.
GITHUB_TOKEN=

# SonarCloud user token (read) and organization key
SONAR_TOKEN=
SONAR_ORG=openmrs

# JIRA (issues.openmrs.org) — anonymous search works for public issues; PAT raises limits
JIRA_BASE_URL=https://openmrs.atlassian.net
JIRA_TOKEN=

# NVD API 2.0 key (raises rate limit 5->50 req/30s) — https://nvd.nist.gov/developers
NVD_API_KEY=

# GitHub orgs in scope, comma-separated (confirm openmrs-contrib with team)
GITHUB_ORGS=openmrs

# Actions security-archetype workflow filename patterns, comma-separated globs.
ARCHETYPE_WORKFLOW_PATTERNS=security*.yml,*security-archetype*.yml

# Dashboard repo that receives CVSS scan pushes (git history = longitudinal record).
DASHBOARD_REPO=
DASHBOARD_RESULT_GLOBS=*.json,*.csv
